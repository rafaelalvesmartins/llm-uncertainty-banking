# bridge-ui — example environment variables
# Copy to .env (or set in your shell / Docker compose) before running.
# Never commit a real .env; this file is safe to commit (placeholders only).
#
# Defaults shown here match the demo / offline mode — the app works
# out of the box without setting any of these.

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Enable EdDSA JWT authentication.
#   off (default) — demo mode, all endpoints open, CI-safe.
#   on            — bearer token required on gated routes.
#   required      — same as "on"; useful for CI enforcement.
# BRIDGE_AUTH=off

# TODO: move to env — demo credentials are currently hardcoded in
# bridge-ui/backend/routers/auth.py (_USERS dict):
#   ana.analista  / demo-ana   (role: analyst)
#   bruno.validador / demo-bruno (role: validator)
#   carla.mrm     / demo-carla  (role: admin)
# These MUST be replaced by a proper identity store before any real deployment.
# BRIDGE_DEMO_USER_ANA_PASSWORD=change-me
# BRIDGE_DEMO_USER_BRUNO_PASSWORD=change-me
# BRIDGE_DEMO_USER_CARLA_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Backend / LLM selection
# ---------------------------------------------------------------------------
# BRIDGE_DEMO_SAFE is the MASTER switch and is checked FIRST.
#   on   (default) — force the deterministic FakeBackend and block all real
#                    bindings. While on, BRIDGE_USE_REAL_LLM below is ignored.
#   off            — opt out; only then is BRIDGE_USE_REAL_LLM consulted.
# Easiest path to a real LLM: ./start-real.sh (it sets BRIDGE_DEMO_SAFE=off).
# BRIDGE_DEMO_SAFE=on
#
# Controls whether the real Ollama LLM is used — ONLY consulted when
# BRIDGE_DEMO_SAFE=off (otherwise you silently get canned FakeBackend answers).
#   auto      (default) — probe Ollama at startup; fall back to FakeBackend.
#   off       — always use FakeBackend (no network calls).
#   required  — fail hard at startup if Ollama + configured model are absent.
# BRIDGE_USE_REAL_LLM=auto

# ---------------------------------------------------------------------------
# LLM providers — Ollama (local)
# ---------------------------------------------------------------------------
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_TIMEOUT_S=25
# OLLAMA_NUM_PREDICT=1024

# ---------------------------------------------------------------------------
# LLM providers — cloud (opt-in via key presence)
# Adapters for OpenAI and Anthropic register automatically when their key is
# set; the offline FakeVisibilityAdapter stays the default when neither key
# is present (so the demo runs anywhere without a cloud account).
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for the FastAPI backend.
# BRIDGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# BRIDGE_RPM=180
# BRIDGE_BURST=30

# ---------------------------------------------------------------------------
# Audit / persistence (SQLite — Postgres/Timescale is the documented prod target)
# ---------------------------------------------------------------------------
# Path to the tamper-evident audit hash-chain SQLite database.
# Set to :memory: to keep ephemeral (used by tests / CI).
# BRIDGE_AUDIT_DB=/tmp/bridge_audit.db

# Path to the governance change-requests SQLite database.
# BRIDGE_CHANGES_DB=/tmp/bridge_changes.db

# ---------------------------------------------------------------------------
# AI Visibility monitoring persistence
# ---------------------------------------------------------------------------
# Path to the visibility run-history SQLite database.
# BRIDGE_VISIBILITY_DB=/tmp/bridge_visibility.db

# In-process visibility scheduler interval in seconds (0 = disabled, the default).
# VISIBILITY_SCHEDULE_EVERY_S=0

# ---------------------------------------------------------------------------
# Frontend — Next.js BFF (set in bridge-ui/frontend/.env.local)
# ---------------------------------------------------------------------------
# URL of the FastAPI backend that the Next.js BFF proxy calls.
# BRIDGE_API_URL=http://localhost:8000

# Playwright E2E port override (test-only).
# E2E_PORT=3001
