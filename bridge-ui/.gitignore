# bridge-ui — scoped .gitignore
# Complements the root llm-uncertainty-banking/.gitignore (which already
# covers .env/.env.*, __pycache__/, *.pyc, .pytest_cache/, .mypy_cache/,
# .ruff_cache/) and bridge-ui/frontend/.gitignore (node_modules/, .next/,
# .env.local, /test-results/, /playwright-report/).
# Only rules that are NOT already covered by those parent files are listed here.

# Secrets — local env overrides
.env
.env.local

# SQLite databases (audit hash-chain, governance changes, visibility history)
*.db
bridge_audit.db
bridge_changes.db
bridge_visibility.db

# Python bytecode / caches (belt-and-suspenders for bridge-ui subdirs)
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend build outputs and test artifacts
node_modules/
.next/
playwright-report/
test-results/

# Coverage reports
coverage/
.coverage
.coverage.*
htmlcov/

# Logs
*.log
.import_linter_cache/
